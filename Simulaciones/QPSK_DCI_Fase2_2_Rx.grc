- name: comparador_mensaje
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nReceptor de texto: reconstruye el mensaje a partir de los\
      \ bytes decididos\ny lo compara con el mensaje transmitido (retardado) caracter\
      \ a caracter.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self, longitud=58, descartar=3):\n \
      \       gr.sync_block.__init__(\n            self,\n            name='Comparador\
      \ de mensaje',\n            in_sig=[np.uint8, np.uint8],   # in0: bytes recibidos,\
      \ in1: bytes transmitidos (retardados)\n            out_sig=None\n        )\n\
      \        self.longitud = longitud\n        self.descartar = descartar  # bytes\
      \ previos al inicio del mensaje (retardo de los filtros)\n        self.buf =\
      \ bytearray()\n        self.ultimo = ''\n        self.n_car = 0\n        self.n_err\
      \ = 0\n\n    def work(self, input_items, output_items):\n        rx = input_items[0]\n\
      \        tx = input_items[1]\n        n = min(len(rx), len(tx))\n        if\
      \ self.descartar > 0:\n            k = min(self.descartar, n)\n            self.descartar\
      \ -= k\n            return k\n        self.n_car += n\n        self.n_err +=\
      \ int(np.count_nonzero(rx[:n] != tx[:n]))\n        self.buf.extend(rx[:n].tobytes())\n\
      \        while len(self.buf) >= self.longitud:\n            linea = self.buf[:self.longitud]\n\
      \            del self.buf[:self.longitud]\n            self.ultimo = ''.join(chr(c)\
      \ if 32 <= c < 127 else '?' for c in linea)\n        return n\n\n    def texto(self):\n\
      \        return self.ultimo\n\n    def tasa_error_caracter(self):\n        return\
      \ self.n_err / self.n_car if self.n_car else 0.0\n"
    affinity: ''
    alias: ''
    comment: ''
    descartar: byte_delay
    longitud: len(mensaje)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Comparador de mensaje', 'blk', [('longitud', '58'), ('descartar',
      '3')], [('0', 'byte', 1), ('1', 'byte', 1)], [], '', ['descartar', 'longitud'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [796.0, 984]
    rotation: 270
    state: enabled
