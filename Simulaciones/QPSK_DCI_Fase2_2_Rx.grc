options:
  parameters:
    author: Grupo A1-GG
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Construido sobre la base de la Guia 2. Tx RRC, canal AWGN calibrado
      en Es/N0 + interferencia senoidal, receptor: filtro acoplado RRC, diagrama de
      ojo, muestreo (Delay + Keep 1 in N), decision de minima distancia, comparacion
      Tx/Rx, SER y BER.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: QPSK_DCI_Fase2_2_Rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Fase 2.2 - Enlace QPSK (DCI): Tx RRC, canal AWGN + tono y receptor digital'
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1904, 8.0]
    rotation: 0
    state: enabled

