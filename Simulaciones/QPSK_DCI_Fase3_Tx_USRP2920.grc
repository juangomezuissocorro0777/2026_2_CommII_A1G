options:
  parameters:
    author: Grupo A1-GG
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Solo transmision. Vector Source con mensaje conocido, QPSK (1, j,
      -1, -j), RRC de energia unitaria, adaptacion de tasa a 250 kS/s y osmocom Sink
      (UHD) a 910 MHz. Sin canal simulado ni receptor.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: QPSK_DCI_Fase3_Tx_USRP2920
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Fase 3 - Transmisor QPSK (DCI) con USRP-2920 a 910 MHz
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1800, 8]
    rotation: 0
    state: enabled

blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 96]
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: ''
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 96]
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: ''
    value: '16000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 96]
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 96]
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
    label: '"Amplitud digital"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '1.8'
    value: '1.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 8]
    rotation: 0
    state: enabled
- name: beta
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 96]
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 96]
    rotation: 0
    state: enabled
- name: decim_usrp
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate/math.gcd(int(samp_rate_usrp),int(samp_rate)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 240]
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: ''
    value: 905e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 240]
    rotation: 0
    state: enabled
- name: ganancia_tx
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: '"Ganancia Tx [dB]"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-10'
    step: '0.5'
    stop: '10'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 8]
    rotation: 0
    state: enabled
- name: interp_usrp
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate_usrp/math.gcd(int(samp_rate_usrp),int(samp_rate)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 240]
    rotation: 0
    state: enabled
- name: lbl_fc
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,2,1,1
    label: '"Portadora [MHz]"'
    type: real
    value: fc/1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 8]
    rotation: 0
    state: enabled
- name: lbl_mensaje_tx
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 0,0,1,3
    label: '"Mensaje transmitido"'
    type: string
    value: mensaje
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 8]
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    comment: ''
    value: '"UIS - Comunicaciones II - Grupo A1-GG - Enlace QPSK DCI. "'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 240]
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters:
    comment: ''
    value: span*Sps+1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 168]
    rotation: 0
    state: enabled
- name: rrc_raw
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(1.0, samp_rate, Rs, beta, ntaps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 168]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: ''
    value: '[t/math.sqrt(sum([x*x for x in rrc_raw])) for t in rrc_raw]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 168]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 96]
    rotation: 0
    state: enabled
- name: samp_rate_usrp
  id: variable
  parameters:
    comment: ''
    value: 6.25e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 260.0]
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: ''
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 96]
    rotation: 0
    state: enabled
- name: tabla_de_verdad_constelacion
  id: variable
  parameters:
    comment: ''
    value: (1+0j, 0+1j, -1+0j, 0-1j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 168]
    rotation: 0
    state: enabled
- name: usrp_args
  id: variable
  parameters:
    comment: ''
    value: '"uhd,addr=192.168.10.2"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 252.0]
    rotation: 0
    state: enabled
- name: adaptacion_tasa
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    decim: decim_usrp
    fbw: '0.4'
    interp: interp_usrp
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 436.0]
    rotation: 0
    state: enabled
- name: bits_to_symbols
  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'False'
    comment: ''
    endianness: gr.GR_MSB_FIRST
    k: '8'
    l: bps
    len_tag_key: '""'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 428.0]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: tabla_de_verdad_constelacion
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 444.0]
    rotation: 0
    state: true
- name: escala_tx
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: amp_tx
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 464.0]
    rotation: 0
    state: enabled
- name: fuente_mensaje
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: list(mensaje.encode("ascii"))
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [0, 420.0]
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 168]
    rotation: 0
    state: enabled
- name: rrc_tx
  id: interp_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    interp: Sps
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 444.0]
    rotation: 0
    state: true
