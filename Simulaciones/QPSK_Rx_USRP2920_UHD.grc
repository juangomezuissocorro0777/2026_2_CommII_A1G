options:
  parameters:
    author: Grupo A1-GG
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Recibe la senal de QPSK_Tx_USRP2920_UHD. AGC, FLL, sincronismo de
      simbolo (PFB), Costas, decision y deteccion del mensaje.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: QPSK_Rx_USRP2920_UHD
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'QPSK Rx USRP-2920: recepcion del mensaje conocido'
    window_size: (1300,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

