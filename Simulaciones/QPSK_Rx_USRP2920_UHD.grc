- name: detector_mensaje
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nDetector del mensaje conocido (recepcion con USRP).\nEntrada:\
      \ indices de simbolo 0..3 decididos con la tabla (1, j, -1, -j).\nEl receptor\
      \ real tiene tres incognitas que el simulador no tenia:\n  - ambiguedad de fase\
      \ de 90 grados del lazo de Costas (indice + k mod 4),\n  - en que simbolo empieza\
      \ cada byte (4 posibilidades),\n  - en que caracter del mensaje empieza la ventana.\n\
      Como el mensaje es conocido, se prueban las 16 combinaciones y se elige la que\
      \ mas\ncaracteres acierta; con ella se muestran el texto recibido y la tasa\
      \ de error de caracter.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\nclass blk(gr.sync_block):\n    def __init__(self, mensaje='UIS - Comunicaciones\
      \ II - Grupo A1-GG - Enlace QPSK DCI. ', ventanas=2):\n        gr.sync_block.__init__(self,\
      \ name='Detector de mensaje', in_sig=[np.uint8], out_sig=None)\n        self.ref\
      \ = np.frombuffer(mensaje.encode('ascii'), dtype=np.uint8)\n        self.L =\
      \ len(self.ref)\n        self.nsym = 4 * self.L * ventanas + 3          # simbolos\
      \ por ventana de analisis\n        self.buf = np.zeros(0, dtype=np.uint8)\n\
      \        # tabla de referencia con todos los desplazamientos ciclicos del mensaje\n\
      \        nb = self.L * ventanas\n        idx = (np.arange(self.L)[:, None] +\
      \ np.arange(nb)[None, :]) % self.L\n        self.ref_shifts = self.ref[idx]\
      \                # (L, nb)\n        self.ultimo = ''\n        self.rot = 0\n\
      \        self.n_car = 0\n        self.n_err = 0\n        self.cer_ventana =\
      \ 1.0\n        self.enganchado = False\n\n    def _bytes(self, s):\n       \
      \ s = s[: (len(s) // 4) * 4].reshape(-1, 4).astype(np.uint16)\n        return\
      \ ((s[:, 0] << 6) | (s[:, 1] << 4) | (s[:, 2] << 2) | s[:, 3]).astype(np.uint8)\n\
      \n    def _analizar(self, s):\n        nb = self.ref_shifts.shape[1]\n     \
      \   mejor = (-1, 0, 0, 0, None)\n        for rot in range(4):\n            sr\
      \ = (s.astype(np.int16) - rot) % 4\n            for off in range(4):\n     \
      \           b = self._bytes(sr[off:off + 4 * nb])\n                aciertos\
      \ = (self.ref_shifts == b[None, :]).sum(axis=1)\n                k = int(np.argmax(aciertos))\n\
      \                if aciertos[k] > mejor[0]:\n                    mejor = (int(aciertos[k]),\
      \ rot, off, k, b)\n        acier, rot, off, k, b = mejor\n        self.rot =\
      \ rot\n        self.cer_ventana = 1.0 - acier / nb\n        # el conteo empieza\
      \ cuando el receptor se engancha (primera ventana con menos de 25 % de error),\n\
      \        # para que la adquisicion de la AGC, el FLL y el Costas no infle la\
      \ tasa de error\n        if not self.enganchado and self.cer_ventana < 0.25:\n\
      \            self.enganchado = True\n        if self.enganchado:\n         \
      \   self.n_car += nb\n            self.n_err += nb - acier\n        ini = (-k)\
      \ % self.L                            # posicion donde empieza el mensaje\n\
      \        linea = b[ini:ini + self.L]\n        self.ultimo = ''.join(chr(c) if\
      \ 32 <= c < 127 else '?' for c in linea)\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        self.buf = np.concatenate((self.buf,\
      \ x))\n        while len(self.buf) >= self.nsym:\n            self._analizar(self.buf[:self.nsym])\n\
      \            self.buf = self.buf[self.nsym:]\n        return len(x)\n\n    def\
      \ texto(self):\n        return self.ultimo\n\n    def tasa_error_caracter(self):\n\
      \        return self.n_err / self.n_car if self.n_car else 0.0\n\n    def estado(self):\n\
      \        if not self.enganchado:\n            return 'Buscando el mensaje...'\n\
      \        return 'Enganchado | ambiguedad de fase corregida: %d grados | error\
      \ ultima ventana: %.1f %%' % (90 * self.rot, 100 * self.cer_ventana)\n\n   \
      \ def rotacion(self):\n        return 90 * self.rot\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    mensaje: mensaje
    minoutbuf: '0'
    ventanas: '2'
  states:
    _io_cache: ('Detector de mensaje', 'blk', [('mensaje', "'UIS - Comunicaciones
      II - Grupo A1-GG - Enlace QPSK DCI. '"), ('ventanas', '2')], [('0', 'byte',
      1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 628.0]
    rotation: 0
    state: enabled
