  parameters: {comment: Decisor de minima distancia sobre la tabla del curso, const_points: tabla_de_verdad_constelacion, sym_map: '[0, 1, 2, 3]', rot_sym: '4', dims: '1', normalization: digital.constellation.NO_NORMALIZATION, precision: '8', npwr: '1.0', soft_dec_lut: None, type: calcdist}
