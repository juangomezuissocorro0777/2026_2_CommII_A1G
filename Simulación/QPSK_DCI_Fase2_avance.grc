    bus_structure: null
    coordinate: [192, 380]
    rotation: 0
    state: enabled
- name: SIR_dB
  id: variable_qtgui_label
  parameters: {comment: 'SIR = P_senal/P_tono, con P_senal = 1/Sps', gui_hint: '1,1,1,1', label: 'SIR [dB]', type: raw, value: 'round(10*math.log10((1.0/Sps)/(interf_amp**2)), 2) if interf_amp > 0 else ''sin interferencia''', formatter: None}
  states:
