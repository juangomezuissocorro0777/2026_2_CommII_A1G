options:
  parameters: {author: '', catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: Basado en Modulaciones_basadas_en_constelaciones_AWGN.grc (flujo base del curso), copyright: '', description: 'Abstraccion academica de un enlace optico coherente DCI: QPSK + RRC + AWGN + interferencia + receptor + BER', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui, hier_block_src_path: '.:', id: QPSK_DCI_Fase2_avance, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}', run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'QPSK con RRC, AWGN e interferencia senoidal - Fase 2 (avance)', window_size: '(1600,1000)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: tabla_de_verdad_constelacion
  id: variable
  parameters: {comment: Cambie esta tabla para OOK ASK BPSK QPSK 8PSK o 16QAM, value: '(1+0j, 0+1j, -1+0j, 0-1j)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 8]
    rotation: 0
    state: enabled
- name: M
  id: variable
  parameters: {comment: '', value: len(tabla_de_verdad_constelacion)}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 8]
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters: {comment: '', value: 'int(math.log(M,2))'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 8]
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters: {comment: 'Tasa de simbolos [sym/s]', value: '16000'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140]
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters: {comment: '', value: '8'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 140]
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters: {comment: 'Tasa de bits [bit/s]', value: Rs*bps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 140]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters: {comment: 'Tasa de muestreo [S/s]', value: Rs*Sps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 140]
    rotation: 0
    state: enabled
- name: beta
  id: variable
  parameters: {comment: Factor de roll-off del RRC, value: '0.35'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 140]
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters: {comment: Duracion del RRC en simbolos, value: '8'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 140]
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters: {comment: '', value: span*Sps+1}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 140]
    rotation: 0
    state: enabled
- name: rrc_raw
  id: variable
  parameters: {comment: RRC de GNU Radio (normalizado a ganancia DC = 1), value: 'firdes.root_raised_cosine(1.0, samp_rate, Rs, beta, ntaps)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 140]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters: {comment: RRC normalizado a energia unitaria (Es = 1 con |a|=1), value: '[t/math.sqrt(sum([x*x for x in rrc_raw])) for t in rrc_raw]'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 140]
    rotation: 0
    state: enabled
- name: rx_delay
  id: variable
  parameters: {comment: 'Retardo [muestras] para muestrear en el pico del filtro acoplado', value: Sps-1}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 140]
    rotation: 0
    state: enabled
- name: sym_delay
  id: variable
  parameters: {comment: Retardo Tx->Rx en simbolos (2 RRC de span/2 simbolos c/u), value: span}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 140]
    rotation: 0
    state: enabled
- name: N_ber
  id: variable
  parameters: {comment: Ventana de bits para la BER en vivo, value: '100000'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 140]
    rotation: 0
    state: enabled
