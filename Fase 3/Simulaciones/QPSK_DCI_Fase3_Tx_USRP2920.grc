  parameters:
    alias: ''
    affinity: ''
    minoutbuf: '0'
    maxoutbuf: '0'
    type: ccc
    interp: interp_usrp
    decim: decim_usrp
    taps: '[]'
    fbw: '0.4'
    comment: 128 kS/s -> 250 kS/s (125/64). Rs = 16 kBd no cambia
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 820
    - 372
    rotation: 0
    state: enabled
