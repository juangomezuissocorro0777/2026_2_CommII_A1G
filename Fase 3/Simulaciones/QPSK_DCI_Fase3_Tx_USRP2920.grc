  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'False'
    comment: 8 bits por byte -> simbolos de bps bits (MSB primero)
    endianness: gr.GR_MSB_FIRST
    k: '8'
    l: bps
    len_tag_key: '""'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 388
    rotation: 0
    state: enabled
