options:
  parameters:
    author: Grupo A1-GG
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Solo transmision. Vector Source con mensaje conocido, QPSK (1, j, -1, -j), RRC de energia unitaria, adaptacion de tasa a 250 kS/s y osmocom Sink (UHD) a 910 MHz. Sin canal simulado ni receptor.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: QPSK_DCI_Fase3_Tx_USRP2920
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Fase 3 - Transmisor QPSK (DCI) con USRP-2920 a 910 MHz
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1800
    - 8
    rotation: 0
    state: enabled
blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 96
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: ''
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 472
    - 96
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: ''
    value: '16000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 96
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 272
    - 96
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 96
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 96
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: ''
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 96
    rotation: 0
    state: enabled
- name: tabla_de_verdad_constelacion
  id: variable
  parameters:
    comment: ''
    value: (1+0j, 0+1j, -1+0j, 0-1j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 168
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 168
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters:
    value: span*Sps+1
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 168
    rotation: 0
    state: enabled
- name: rrc_raw
  id: variable
  parameters:
    value: firdes.root_raised_cosine(1.0, samp_rate, Rs, beta, ntaps)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 96
    - 168
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    value: '[t/math.sqrt(sum([x*x for x in rrc_raw])) for t in rrc_raw]'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 288
    - 168
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    value: '"UIS - Comunicaciones II - Grupo A1-GG - Enlace QPSK DCI. "'
    comment: Mensaje conocido (solo ASCII)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 240
    rotation: 0
    state: enabled
- name: fuente_mensaje
  id: blocks_vector_source_x
  parameters:
    alias: ''
    affinity: ''
    minoutbuf: '0'
    maxoutbuf: '0'
    type: byte
    vector: list(mensaje.encode("ascii"))
    tags: '[]'
    repeat: 'True'
    vlen: '1'
    comment: 'Vector Source: mensaje conocido'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 380
    rotation: 0
    state: enabled
