- name: samp_rate_usrp
  id: variable
  parameters:
    value: 250e3
    comment: '100 MHz / 400: tasa entera admitida por la USRP-2920'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 240
    rotation: 0
    state: enabled
